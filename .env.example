# Copy to .env.local for local development. Never commit real values.

# Canonical public URL (links in emails, Open Graph). Placeholder until the domain is bought.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Settings → API Keys). Publishable key is safe in the browser (RLS applies).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…): server only, read exclusively by lib/supabase/admin.ts.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile site key (the secret key is entered in Supabase Auth → Captcha).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Resend HTTP API (e-mails of the app; Vercel: type "sensitive"). The Auth e-mails go through the
# SMTP of Resend, set in Supabase Auth → SMTP. EMAIL_FROM: the bare address (the name is added).
RESEND_API_KEY=
EMAIL_FROM=ne-pas-repondre@bad-boys8bad-girls.fr

# Web Push (Phase 5a). Generate with `npx web-push generate-vapid-keys`. The private key and the
# push secret are server-only (Vercel: type "sensitive"); the same secret goes in the Supabase
# Vault (push_cron_secret) so that pg_net can call /api/cron/push.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# https URL of the site or mailto: address, sent to the push services as a contact.
VAPID_SUBJECT=
# At least 32 characters. Also guards /api/cron/email and /api/cron/cleanup (called by pg_net).
PUSH_CRON_SECRET=

# development | preview | production. "production" hides the /design showcase.
APP_ENV=development

# Dev seed guard (SPEC §19): must be "true" AND APP_ENV != production.
ALLOW_DEV_SEED=false

# Sign-ups (no production database yet): false on Vercel Production, true on Preview and locally.
# Closed unless exactly "true" (absent or any other value = closed).
SIGNUPS_OPEN=true
